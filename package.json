{
  "name": "@junieyass/junie",
  "version": "1.0.2",
  "description": "Junie — a production-grade, developer-first Lavalink v4 client for Node.js and TypeScript.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "lavalink",
    "lavalink-v4",
    "discord",
    "discord-bot",
    "music",
    "audio",
    "player",
    "queue",
    "voice",
    "wrapper",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junieyass/junie.git"
  },
  "homepage": "https://github.com/junieyass/junie#readme",
  "bugs": {
    "url": "https://github.com/junieyass/junie/issues"
  },
  "author": "junieyass",
  "license": "MIT",
  "sideEffects": false,
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  }
}
